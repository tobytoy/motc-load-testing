          },
          "allowRtnFromDiffStation": {
            "type": "boolean",
            "example": true
          },
          "carplusService": {
            "enum": [
              "LONG_RENT",
              "SHORT_RENT",
              "PREOWNED"
            ],
            "type": "string",
            "example": "1"
          },
          "cityId": {
            "type": "integer",
            "format": "int32",
            "example": "1"
          },
          "code": {
            "type": "string",
            "example": "218"
          },
          "descr": {
            "type": "string",
            "example": "靠近新店家樂福"
          },
          "email": {
            "type": "string"
          },
          "landmarkList": {
            "type": "array",
