{
  "openapi": "3.0.4",
  "info": {
    "title": "空間參照",
    "description": "<br>計費方式：\n<br>計次：200次/1點\n<br>計量：20MB/1點\n---\n##### API使用說明與注意事項：\n1. 如您尚未註冊平臺會員帳號，或未以帳號登入，您將僅能以「訪客模式」使用平臺服務，包含：限以瀏覽器存取，限使用`【基礎服務】`，且限制每個呼叫來源端IP每日存取至多20次。。\n2. 如您已註冊平臺會員帳號，請務必確保在存取服務(包含瀏覽器、程式呼叫API)時帶入您的API金鑰，方能以「會員模式」使用完整平臺服務，包含平臺各類資料服務，如`【基礎服務】`、`【進階服務】`、`【加值服務】`、`【歷史服務】`、`【圖資服務】`、`【第三方服務】`等。\n3. 建議您立即[註冊平臺會員帳號](/register)，依您用量需求訂閱服務方案，並於[【會員中心->資料服務->API金鑰】](/user/dataservice/key)取得API金鑰(即Client Id和Client Secret資訊)。\n4. 會員訂閱服務方案之級別不同，將決定其API金鑰之存取頻率有不同限制，各個方案的存取頻率限制說明請參考[訂閱收費](/pricing)。\n5. 以瀏覽器帶入API金鑰之操作方式：請點選Swagger UI上的Authorize按鈕，依指示填入Client Id和Client Secret資訊並進行驗證，驗證完成後可開始於Swagger UI使用API。\n6. 以程式呼叫API帶入API金鑰之操作方式：請參考[範例程式](https://github.com/tdxmotc/SampleCode)。\n7. 不論您是以瀏覽器或是以程式呼叫API，所有服務存取行為均將被記錄並定期檢視，以確保系統資源使用的合理分配與避免遭受濫用。\n\nAPI OAS文本 :[請點我](https://tdx.transportdata.tw/webapi/File/Swagger/V3/d95e992f-4a3f-4308-9a6e-69e97ed42495)",
    "termsOfService": "https://tdx.transportdata.tw/term",
    "contact": {
      "name": "TDX客服信箱",
      "email": "tdx@motc.gov.tw"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://tdx.transportdata.tw/api/advanced"
    }
  ],
  "paths": {
    "/Geocoding/Mileage/{RoadName}/{Direction}/{FromMileage}/to/{ToMileage}": {
      "get": {
        "tags": [
          "Geocoding"
        ],
        "summary": "國快省縣道路(里程)",
        "description": "查詢道路里程的經緯度資訊",
        "operationId": "Geocoding_Mileage",
        "parameters": [
          {
            "name": "RoadName",
            "in": "path",
            "description": "道路名稱",
            "required": true,
            "schema": {
              "type": "string",
              "example": "國道1號"
            }
          },
          {
            "name": "Direction",
            "in": "path",
            "description": "道路方向",
            "required": true,
            "schema": {
              "enum": [
                "南向",
                "北向",
                "東向",
                "西向"
              ],
              "type": "string",
              "example": "南向"
            }
          },
          {
            "name": "FromMileage",
            "in": "path",
            "description": "起點里程",
            "required": true,
            "schema": {
              "type": "string",
              "example": "0K+400"
            }
          },
          {
            "name": "ToMileage",
            "in": "path",
            "description": "迄點里程",
            "required": true,
            "schema": {
              "type": "string",
              "example": "5K+500"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功回傳結果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Status": {
                      "type": "string",
                      "description": "回傳狀態"
                    },
                    "Result": {
                      "type": "object",
                      "properties": {
                        "FromPositionLon": {
                          "type": "string",
                          "description": "起點里程經度"
                        },
                        "FromPositionLat": {
                          "type": "string",
                          "description": "起點里程緯度"
                        },
                        "ToPositionLon": {
                          "type": "string",
                          "description": "迄點里程經度"
                        },
                        "ToPositionLat": {
                          "type": "string",
                          "description": "迄點里程緯度"
                        },
                        "Geometry": {
                          "type": "string",
                          "description": "WKT 格式的 LINESTRING 字串，例如：LINESTRING(121.5 25.0, 121.6 25.1)"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/Geocoding/CityRoad/{City}/{TownName}/{RoadName}/{RoadDirection}": {
      "get": {
        "tags": [
          "Geocoding"
        ],
        "summary": "市區道路",
        "description": "查詢市區道路的經緯度資訊",
        "operationId": "Geocoding_CityRoad",
        "parameters": [
          {
            "name": "City",
            "in": "path",
            "description": "縣市名稱",
            "required": true,
            "schema": {
              "enum": [
                "臺北市",
                "臺中市",
                "基隆市",
                "臺南市",
                "高雄市",
                "新北市",
                "宜蘭縣",
                "桃園市",
                "嘉義市",
                "新竹縣",
                "苗栗縣",
                "南投縣",
                "彰化縣",
                "新竹市",
                "雲林縣",
                "嘉義縣",
                "屏東縣",
                "花蓮縣",
                "臺東縣",
                "金門縣",
                "澎湖縣",
                "連江縣"
              ],
              "type": "string",
              "example": "臺北市"
            }
          },
          {
            "name": "TownName",
            "in": "path",
            "description": "鄉鎮市區名稱",
            "required": true,
            "schema": {
              "type": "string",
              "example": "中正區"
            }
          },
          {
            "name": "RoadName",
            "in": "path",
            "description": "道路名稱",
            "required": true,
            "schema": {
              "type": "string",
              "example": "信義路一段"
            }
          },
          {
            "name": "RoadDirection",
            "in": "path",
            "description": "道路方向",
            "required": true,
            "schema": {
              "enum": [
                "北",
                "東北",
                "東",
                "東南",
                "南",
                "西南",
                "西",
                "西北"
              ],
              "type": "string",
              "example": "東南"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功回傳結果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Status": {
                      "type": "string",
                      "description": "回傳狀態"
                    },
                    "Result": {
                      "type": "object",
                      "properties": {
                        "PositionLon": {
                          "type": "string",
                          "description": "道路起點經度"
                        },
                        "PositionLat": {
                          "type": "string",
                          "description": "道路起點緯度"
                        },
                        "Geometry": {
                          "type": "string",
                          "description": "WKT 格式的 LINESTRING 字串，例如：LINESTRING(121.5 25.0, 121.6 25.1)"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/Geocoding/Intersection/{City}/{Intersection}": {
      "get": {
        "tags": [
          "Geocoding"
        ],
        "summary": "交叉路口",
        "description": "查詢交叉路口的經緯度資訊",
        "operationId": "Geocoding_Intersection",
        "parameters": [
          {
            "name": "City",
            "in": "path",
            "description": "縣市名稱",
            "required": true,
            "schema": {
              "enum": [
                "臺北市",
                "臺中市",
                "基隆市",
                "臺南市",
                "高雄市",
                "新北市",
                "宜蘭縣",
                "桃園市",
                "嘉義市",
                "新竹縣",
                "苗栗縣",
                "南投縣",
                "彰化縣",
                "新竹市",
                "雲林縣",
                "嘉義縣",
                "屏東縣",
                "花蓮縣",
                "臺東縣",
                "金門縣",
                "澎湖縣",
                "連江縣"
              ],
              "type": "string",
              "example": "臺北市"
            }
          },
          {
            "name": "Intersection",
            "in": "path",
            "description": "交叉路口名稱，可輸入單個或多個路名，路名之間用,分隔",
            "required": true,
            "schema": {
              "type": "string",
              "example": "仁愛路一段,杭州南路一段"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功回傳結果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Status": {
                      "type": "string",
                      "description": "回傳狀態"
                    },
                    "Result": {
                      "type": "object",
                      "properties": {
                        "PositionLon": {
                          "type": "string",
                          "description": "交叉路口經度"
                        },
                        "PositionLat": {
                          "type": "string",
                          "description": "交叉路口緯度"
                        },
                        "CNodeID": {
                          "type": "string",
                          "description": "路口中心點代碼"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
